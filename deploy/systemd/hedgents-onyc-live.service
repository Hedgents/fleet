[Unit]
Description=Hedgents onyc-daemon (LIVE mainnet — RWA reinsurance leverage)
After=network-online.target
Wants=network-online.target
PartOf=hedgents-live.target
# Mutual exclusion with paper-mode unit (analog of multiply pattern).
Conflicts=hedgents-onyc.service

[Service]
StandardOutput=append:/var/lib/hedgents/logs/onyc-live.log
StandardError=append:/var/lib/hedgents/logs/onyc-live.log
Type=simple
User=hedgents
Group=hedgents
WorkingDirectory=/var/lib/hedgents
EnvironmentFile=/etc/hedgents/hedgents.env
# Position size: $500 v0 ceiling (500_000_000 USDC lamports, 6 decimals).
# Well below MAX_POSITION_USDC_LAMPORTS=$500K hard cap in caps.rs.
# Bumped per-quarter after observed behavior matches expectations.
#
# Auto-mode flags carry over from multiply's pattern. The onyc-daemon's
# auto_mode.rs accepts the same shape (forked from multiply).
ExecStart=/opt/hedgents/bin/onyc-daemon run \
    --secrets-dir=/var/lib/hedgents/secrets \
    --wallet=/var/lib/hedgents/secrets/solana-wallet.json \
    --rpc-url=${RPC_URL} \
    --listen=/ip4/0.0.0.0/tcp/19315 \
    --beacon-interval-secs=5 \
    --network=mainnet \
    --i-understand-this-is-mainnet \
    --orchestrator-agent-id=${ORCHESTRATOR_PUBKEY} \
    --simulate-only=false \
    --require-approval=true \
    --max-position-usdc-lamports=500000000 \
    --pnl-log=/var/lib/hedgents/logs/onyc-live-pnl.jsonl
Restart=always
RestartSec=5s
StartLimitBurst=10
StartLimitIntervalSec=120

# Security hardening (parity with multiply / hedgedjlp / stable-yield units).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hedgents
PrivateTmp=true

[Install]
WantedBy=hedgents-live.target
